{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://philovista-1800.local/schemas/framework_draft_record.schema.json",
  "title": "PhiloVista-1800 framework-aligned AI draft record",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotation_item_id", "sample_id", "file_name", "track", "benchmark_axis_id", "ontology_version", "ontology_sha256", "annotation_source", "formal_gold", "mapping_status", "interpretations"],
  "properties": {
    "annotation_item_id": {"type": "string", "pattern": "^F[0-9]{4}$"},
    "sample_id": {"type": "string", "minLength": 1},
    "file_name": {"type": "string", "minLength": 1},
    "track": {"enum": ["positive", "boundary"]},
    "benchmark_axis_id": {"type": "string", "minLength": 1},
    "ontology_version": {"const": "formal-632-20260909"},
    "ontology_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "annotation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method", "review_verdict"],
      "properties": {
        "kind": {"const": "reviewed_ai_draft"},
        "method": {"type": "string", "minLength": 1},
        "review_verdict": {"type": "string", "minLength": 1}
      }
    },
    "formal_gold": {"const": false},
    "mapping_status": {"const": "pending_independent_human_mapping"},
    "needs_independent_human_annotation": {"const": true},
    "needs_independent_human_rating": {"const": true},
    "interpretations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "visual_anchors", "symbolic_mapping", "legacy_axis_ids", "formal_concept_candidates", "concept_claims", "interpretation", "alternative_interpretations", "limitations", "sufficiency"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "visual_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "symbolic_mapping": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "legacy_axis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "formal_concept_candidates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PHC-[0-9]{3}$"}},
          "concept_claims": {"type": "array", "maxItems": 0},
          "interpretation": {"type": "string", "minLength": 1},
          "alternative_interpretations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sufficiency": {"enum": ["supported", "plausible", "insufficient", "not_applicable"]}
        }
      }
    }
  }
}
